rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Notas fiscais anexadas a lançamentos do fluxo de caixa.
    match /users/{userId}/nfs/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Foto de perfil do usuário. O app envia sempre um JPEG 256x256 (~30 KB);
    // o guard de tamanho/tipo impede uso do caminho como storage genérico.
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Comprovantes de contas a pagar / a receber / impostos.
    match /bills/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /receivables/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /taxes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
